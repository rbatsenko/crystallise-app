{
  "name": "crystallise",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun --filter @crystallise/web dev",
    "dev:admin": "bun --filter @crystallise/admin dev",
    "build:web": "bun --filter @crystallise/web build",
    "build:admin": "bun --filter @crystallise/admin build",
    "lint": "bun --filter '*' lint"
  },
  "trustedDependencies": [
    "canvas",
    "sharp",
    "unrs-resolver"
  ]
}
